<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.richtext.CodeArea?>

<AnchorPane fx:id="anchorPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
   <children>
      <VBox fx:id="vBox" prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox fx:id="hBox" spacing="5.0">
               <children>
                  <TextField fx:id="filePathAndNameTextFieldValue" promptText="%PathToXmlFile" HBox.hgrow="ALWAYS" />
                  <Button fx:id="selectButton" mnemonicParsing="false" onAction="#selectAction" text="%Select" HBox.hgrow="NEVER" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </HBox>
            <CodeArea VBox.vgrow="ALWAYS" />
            <ToolBar fx:id="toolBar" nodeOrientation="RIGHT_TO_LEFT">
               <items>
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancelAction" text="%Cancel" />
                  <Button fx:id="acceptButton" mnemonicParsing="false" onAction="#acceptAction" text="%Accept" />
               </items>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </ToolBar>
         </children>
      </VBox>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox id="AnchorPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox spacing="5.0" VBox.vgrow="NEVER">
               <children>
                  <TextField fx:id="filePathAndNameTextFieldValue" promptText="Path to the *.ics file" HBox.hgrow="ALWAYS" />
                  <Button fx:id="selectButton" mnemonicParsing="false" onAction="#selectAction" text="%Select" HBox.hgrow="NEVER" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </HBox>
            <TableView fx:id="holydayTableView">
               <columns>
                  <TableColumn fx:id="holydayDateTableColumn" text="%HolydayDate" />
                  <TableColumn fx:id="holydayNameTableColumn" text="%HolydayName" />
                  <TableColumn fx:id="holydayStateTableColumn" text="%HolydayState" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <ToolBar nodeOrientation="RIGHT_TO_LEFT" VBox.vgrow="NEVER">
              <items>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#cancelAction" text="%Cancel" />
                <Button fx:id="acceptButton" mnemonicParsing="false" onAction="#acceptAction" text="%Accept" />
              </items>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </ToolBar>
         </children>
      </VBox>
   </children>
</AnchorPane>
